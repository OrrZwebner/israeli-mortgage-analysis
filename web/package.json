{
  "name": "mortgage-analysis-web",
  "version": "1.0.0",
  "private": true,
  "description": "Local dashboard for the mortgage-refinance-analysis skill: drop bank PDFs, get a Hebrew report.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/server.js",
    "dev": "tsc -p tsconfig.json --watch & node --watch dist/server.js",
    "doctor": "npm run build && node dist/doctor-cli.js",
    "smoke": "npm run build && node dist/smoke.js",
    "test": "npm run build && node --test dist/permissions.test.js"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.1.0",
    "express": "^4.21.2",
    "markdown-it": "^14.1.0",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/markdown-it": "^14.1.2",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
